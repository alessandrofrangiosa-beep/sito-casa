# Copia questo file in .env.local (in locale) oppure inserisci le variabili su Vercel
# (Project → Settings → Environment Variables). Non scrivere mai chiavi reali in questo file.

# ── "Arredala tu" (render AI) ──
# Chiave OpenAI: letta SOLO dalla API route src/app/api/render/route.ts, mai inviata al browser.
OPENAI_API_KEY=

# ── Contatti ──
# Numero WhatsApp in formato internazionale senza "+" né spazi, es. 393331234567
NEXT_PUBLIC_WHATSAPP_NUMBER=
