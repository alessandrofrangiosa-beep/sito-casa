# Copia questo file in .env.local e compila i valori.
# ── Render AI (ne basta UNO dei due; se presenti entrambi viene usato fal.ai) ──
# fal.ai — Flux Kontext (consigliato: mantiene pareti, finestre e vista)
FAL_KEY=
# Modello fal.ai (opzionale)
FAL_MODEL=fal-ai/flux-pro/kontext
# OpenAI — Image Edit
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ── Contatti ──
# Numero WhatsApp in formato internazionale senza "+" né spazi, es. 393331234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Lead dal modulo "sblocca altri render" (opzionale) ──
# URL a cui inviare in POST i numeri lasciati dai visitatori (es. webhook Make/Zapier/Google Sheets)
LEAD_WEBHOOK_URL=
